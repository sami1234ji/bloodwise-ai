# Copy this file to .env and fill in what you need. Never commit .env.
#
# The application is fully usable with none of these set. Without an API key it
# uses its rule-based explanations, which are complete on their own.

# Optional: turns on the AI rewriting layer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Windows only: the full path to tesseract.exe, if it is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
